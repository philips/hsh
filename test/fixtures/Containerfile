FROM registry.fedoraproject.org/fedora:latest

LABEL org.opencontainers.image.title="hsh test fixture workspace" \
      org.opencontainers.image.description="Fedora workspace image with the Pi coding agent pre-installed, the functional test's sandbox image"

ENV HOME=/home/hsh
ENV PI_OFFLINE=1
RUN dnf install -y nodejs npm curl fd-find ripgrep && dnf clean all
RUN mkdir -p /home/hsh && curl -fsSL https://pi.dev/install.sh | sh
ENV PATH="/home/hsh/.pi/agent/bin:${PATH}"
