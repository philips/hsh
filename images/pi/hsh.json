{
  "version": 2,
  "shell": "/bin/bash",
  "secrets": {
    "MISTRAL_API_KEY": {
      "from": "hsh://mistral-api-key",
      "hosts": [
        "api.mistral.ai"
      ],
      "header": "Authorization",
      "prefix": "Bearer "
    },
    "ANTHROPIC_API_KEY": {
      "from": "hsh://anthropic-api-key",
      "hosts": [
        "api.anthropic.com"
      ],
      "header": "x-api-key"
    },
    "OPENAI_API_KEY": {
      "from": "hsh://openai-api-key",
      "hosts": [
        "api.openai.com"
      ],
      "header": "Authorization",
      "prefix": "Bearer "
    }
  },
  "network": {
    "allow": [
      "ab.chatgpt.com",
      "api.anthropic.com",
      "api.mistral.ai",
      "api.openai.com",
      "auth.openai.com",
      "chatgpt.com"
    ],
    "mode": "allowlist"
  },
  "oauth": {
    "providers": [
      "openai",
      "openai-codex"
    ]
  },
  "agent": {
    "command": [
      "pi",
      "--append-system-prompt",
      "{network_policy}",
      "-p",
      "{prompt}"
    ],
    "launch": [
      "pi",
      "--append-system-prompt",
      "{network_policy}"
    ]
  }
}
