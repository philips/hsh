FROM registry.fedoraproject.org/fedora:latest

LABEL org.opencontainers.image.title="hsh Pi workspace" \
      org.opencontainers.image.description="Fedora workspace image with the Pi coding agent pre-installed, for use as the hsh workspace image"

LABEL org.ifup.hsh='{"shell":"/bin/bash","secrets":{"MISTRAL_API_KEY":{"from":"hsh://mistral-api-key","hosts":["api.mistral.ai"],"header":"Authorization","prefix":"Bearer "},"ANTHROPIC_API_KEY":{"from":"hsh://anthropic-api-key","hosts":["api.anthropic.com"],"header":"x-api-key"},"OPENAI_API_KEY":{"from":"hsh://openai-api-key","hosts":["api.openai.com"],"header":"Authorization","prefix":"Bearer "}},"network":{"allow":["api.mistral.ai","api.anthropic.com","api.openai.com","auth.openai.com"],"mode":"allowlist"},"agent":{"command":["pi","-p","{prompt}"],"launch":["pi"]}}'

ENV HOME=/home/hsh
ENV PI_OFFLINE=1
RUN dnf install -y bash nodejs npm curl git fd-find ripgrep && dnf clean all
RUN mkdir -p /home/hsh && curl -fsSL https://pi.dev/install.sh | sh
ENV PATH="/home/hsh/.pi/agent/bin:${PATH}"
