FROM registry.fedoraproject.org/fedora:latest

LABEL org.opencontainers.image.title="hsh Claude Code workspace" \
      org.opencontainers.image.description="Fedora workspace image with Claude Code pre-installed, for use as the hsh workspace image"

ARG HSH_LABEL
LABEL org.ifup.hsh="${HSH_LABEL}"

ENV HOME=/home/hsh
RUN dnf install -y bash curl git fd-find ripgrep && dnf clean all
RUN mkdir -p /home/hsh && curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/home/hsh/.local/bin:${PATH}"
