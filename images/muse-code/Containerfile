FROM registry.fedoraproject.org/fedora:latest

LABEL org.opencontainers.image.title="hsh Muse Code workspace" \
      org.opencontainers.image.description="Fedora workspace image with Meta Muse Code pre-installed, for use as the hsh workspace image"

ARG HSH_LABEL
LABEL org.ifup.hsh="${HSH_LABEL}"

ENV HOME=/home/hsh
ENV MUSE_NO_AUTO_UPDATE=1
ENV META_API_KEY=placeholder
RUN dnf install -y bash curl git fd-find ripgrep && dnf clean all
RUN mkdir -p /home/hsh && curl -fsSL https://dev.meta.ai/install.sh | sh
ENV PATH="/home/hsh/.local/bin:${PATH}"
