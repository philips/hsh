FROM registry.fedoraproject.org/fedora:latest

LABEL org.opencontainers.image.title="hsh OpenAI Codex workspace" \
      org.opencontainers.image.description="Fedora workspace image with the OpenAI Codex CLI pre-installed, for use as the hsh workspace image"

ARG HSH_LABEL
LABEL org.ifup.hsh="${HSH_LABEL}"

ENV HOME=/home/hsh
RUN dnf install -y bash curl git fd-find ripgrep procps-ng bubblewrap && dnf clean all
RUN mkdir -p /home/hsh/.codex && printf 'sandbox_mode = "danger-full-access"\n' > /home/hsh/.codex/config.toml
RUN mkdir -p /home/hsh && CODEX_NON_INTERACTIVE=true curl -fsSL https://chatgpt.com/codex/install.sh | sh
ENV PATH="/home/hsh/.local/bin:${PATH}"
