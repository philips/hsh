+
+package netbackend
+
+import (
+	"bufio"
+	"context"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"log/slog"
+	"net"
+	"sync"
+	"sync/atomic"
+
+	"z.gfire.dev/gvx/pkg/buffer"
+	"z.gfire.dev/gvx/pkg/tcpip"
+	"z.gfire.dev/gvx/pkg/tcpip/header"
+	"z.gfire.dev/gvx/pkg/tcpip/link/channel"
+	"z.gfire.dev/gvx/pkg/tcpip/network/ipv4"
+	"z.gfire.dev/gvx/pkg/tcpip/network/ipv6"
+	"z.gfire.dev/gvx/pkg/tcpip/stack"
+)
+
+// PacketLinkHeaderLen is the size of the frame header on a packet link: the
+// length of the IP packet that follows, as a big-endian uint32.
+const PacketLinkHeaderLen = 4
+
+// DefaultPacketLinkMTU is the MTU of eth0 on a packet link when
+// PacketLinkConfig.MTU is zero.
+const DefaultPacketLinkMTU = 1500
+
+const packetLinkQueueLen = 1024
+
+// PacketLinkConfig configures a guest eth0 that exchanges IP packets with an
+// external peer over a byte stream.
+//
+// Each frame on Conn, in both directions, is a PacketLinkHeaderLen-byte
+// big-endian length followed by one IPv4 or IPv6 packet with no link-layer
+// header. The peer receives every packet that the guest sends to an address
+// outside lo, from 10.0.2.15 to any destination, so it must accept packets
+// for every address. The guest does not verify the transport checksums of
+// packets from the peer; it computes the checksums of the packets it sends.
+type PacketLinkConfig struct {
+	// Conn is the connected stream to the peer, such as an AF_UNIX
+	// SOCK_STREAM socket. The link owns it and closes it on Close.
+	Conn net.Conn
+
+	// MTU is the MTU of eth0. Zero selects DefaultPacketLinkMTU.
+	MTU uint32
+
+	// Stack selects the optional features of the guest network stack.
+	Stack StackOptions
+
+	// Logger receives link diagnostics. When nil, they are discarded.
+	Logger *slog.Logger
+}
+
+// PacketLink attaches the guest eth0 to an external peer over a byte stream.
+type PacketLink struct {
+	cfg    PacketLinkConfig
+	log    *slog.Logger
+	paused atomic.Bool
+
+	mu      sync.Mutex
+	conn    net.Conn
+	ep      *channel.Endpoint
+	cancel  context.CancelFunc
+	wg      sync.WaitGroup
+	closed  bool
+	lastErr error
+}
+
+// NewPacketLink validates cfg and returns a link that is not attached to a
+// stack yet. Attach or AttachRestoredStack starts it.
+func NewPacketLink(cfg PacketLinkConfig) (*PacketLink, error) {
+	if cfg.Conn == nil {
+		return nil, errors.New("netbackend: packet link needs a connection")
+	}
+	if cfg.MTU == 0 {
+		cfg.MTU = DefaultPacketLinkMTU
+	}
+	if cfg.MTU < header.IPv4MinimumMTU || cfg.MTU > MaxLinkMTU {
+		return nil, fmt.Errorf("netbackend: packet link MTU %d is outside %d..%d", cfg.MTU, header.IPv4MinimumMTU, MaxLinkMTU)
+	}
+	log := cfg.Logger
+	if log == nil {
+		log = discardLogger
+	}
+	return &PacketLink{cfg: cfg, log: log}, nil
+}
+
+// NewPacketLinkStack creates a guest Netstack with lo (127.0.0.1/8) and eth0
+// (10.0.2.15/24, default route through 10.0.2.2) attached to cfg.Conn.
+func NewPacketLinkStack(cfg PacketLinkConfig) (*stack.Stack, *PacketLink, error) {
+	l, err := NewPacketLink(cfg)
+	if err != nil {
+		return nil, nil, err
+	}
+	s, err := NewLoopbackStack(cfg.Stack)
+	if err != nil {
+		return nil, nil, err
+	}
+	if err := l.Attach(s); err != nil {
+		s.Close()
+		return nil, nil, err
+	}
+	return s, l, nil
+}
+
+// Attach adds eth0 to s, a stack that already has lo, and starts moving
+// packets between eth0 and the connection.
+func (l *PacketLink) Attach(s *stack.Stack) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.closed {
+		return errors.New("netbackend: packet link is closed")
+	}
+	if l.ep != nil {
+		return errors.New("netbackend: packet link is already attached")
+	}
+	return l.attachLocked(s)
+}
+
+func (l *PacketLink) attachLocked(s *stack.Stack) error {
+	conn := l.cfg.Conn
+	ep := channel.New(packetLinkQueueLen, l.cfg.MTU, "")
+	ep.LinkEPCapabilities = stack.CapabilityRXChecksumOffload
+	if err := createNamedNICWithMTURange(s, Eth0NICID, Eth0NICName, ep, header.IPv4MinimumMTU, MaxLinkMTU); err != nil {
+		ep.Close()
+		return err
+	}
+	ethAddr := tcpip.ProtocolAddress{
+		Protocol: ipv4.ProtocolNumber,
+		AddressWithPrefix: tcpip.AddressWithPrefix{
+			Address:   tcpip.AddrFrom4([4]byte{10, 0, 2, 15}),
+			PrefixLen: 24,
+		},
+	}
+	if err := s.AddProtocolAddress(Eth0NICID, ethAddr, stack.AddressProperties{}); err != nil {
+		ep.Close()
+		return fmt.Errorf("netbackend: add 10.0.2.15/24 to eth0: %s", err)
+	}
+	s.SetRouteTable([]tcpip.Route{
+		{Destination: header.IPv4LoopbackSubnet, NIC: LoopbackNICID},
+		{Destination: header.IPv4EmptySubnet, Gateway: hostGatewayAddr, NIC: Eth0NICID},
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	l.conn, l.ep, l.cancel, l.lastErr = conn, ep, cancel, nil
+	l.wg.Add(2)
+	go l.readLoop(ctx, conn, ep)
+	go l.writeLoop(ctx, conn, ep)
+	return nil
+}
+
+func (l *PacketLink) readLoop(ctx context.Context, conn net.Conn, ep *channel.Endpoint) {
+	defer l.wg.Done()
+	r := bufio.NewReaderSize(conn, 256<<10)
+	var hdr [PacketLinkHeaderLen]byte
+	for {
+		if _, err := io.ReadFull(r, hdr[:]); err != nil {
+			l.fail(ctx, conn, fmt.Errorf("read frame header: %w", err))
+			return
+		}
+		n := binary.BigEndian.Uint32(hdr[:])
+		if n == 0 || n > MaxLinkMTU {
+			l.fail(ctx, conn, fmt.Errorf("frame length %d is outside 1..%d", n, MaxLinkMTU))
+			return
+		}
+		buf := buffer.NewViewSize(int(n))
+		if _, err := io.ReadFull(r, buf.AsSlice()); err != nil {
+			buf.Release()
+			l.fail(ctx, conn, fmt.Errorf("read frame: %w", err))
+			return
+		}
+		if l.paused.Load() {
+			buf.Release()
+			continue
+		}
+		var proto tcpip.NetworkProtocolNumber
+		switch header.IPVersion(buf.AsSlice()) {
+		case header.IPv4Version:
+			proto = ipv4.ProtocolNumber
+		case header.IPv6Version:
+			proto = ipv6.ProtocolNumber
+		default:
+			buf.Release()
+			continue
+		}
+		pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithView(buf)})
+		ep.InjectInbound(proto, pkt)
+		pkt.DecRef()
+	}
+}
+
+func (l *PacketLink) writeLoop(ctx context.Context, conn net.Conn, ep *channel.Endpoint) {
+	defer l.wg.Done()
+	var hdr [PacketLinkHeaderLen]byte
+	for {
+		pkt := ep.ReadContext(ctx)
+		if pkt == nil {
+			return
+		}
+		if l.paused.Load() {
+			pkt.DecRef()
+			continue
+		}
+		v := pkt.ToView()
+		pkt.DecRef()
+		binary.BigEndian.PutUint32(hdr[:], uint32(v.Size()))
+		bufs := net.Buffers{hdr[:], v.AsSlice()}
+		_, err := bufs.WriteTo(conn)
+		v.Release()
+		if err != nil {
+			l.fail(ctx, conn, fmt.Errorf("write frame: %w", err))
+			return
+		}
+	}
+}
+
+func (l *PacketLink) fail(ctx context.Context, conn net.Conn, err error) {
+	if ctx.Err() != nil {
+		return
+	}
+	l.mu.Lock()
+	if l.lastErr == nil {
+		l.lastErr = err
+	}
+	l.mu.Unlock()
+	l.log.Warn("netbackend: packet link down", "error", err)
+	_ = conn.Close()
+}
+
+// Err returns the error that took the link down, or nil while it is up.
+func (l *PacketLink) Err() error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.lastErr
+}
+
+// QuiesceForSave drops the packets of the link while the kernel saves its
+// state.
+func (l *PacketLink) QuiesceForSave() {
+	l.paused.Store(true)
+}
+
+// ResumeAfterSave passes packets again after a checkpoint save.
+func (l *PacketLink) ResumeAfterSave() error {
+	l.paused.Store(false)
+	return nil
+}
+
+// AttachRestoredStack rebuilds lo and eth0 on a restored guest Netstack and
+// starts the link on it. The link must not be attached yet: the connection of
+// the saved sandbox does not survive a checkpoint, so a restore starts with a
+// new connection in PacketLinkConfig.Conn.
+func (l *PacketLink) AttachRestoredStack(restored *stack.Stack) error {
+	if restored == nil {
+		return errors.New("netbackend: restored stack is nil")
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.closed {
+		return errors.New("netbackend: packet link is closed")
+	}
+	if l.ep != nil {
+		return errors.New("netbackend: packet link is already attached")
+	}
+	restored.ResetConfig()
+	if err := configureLoopbackNIC(restored, LoopbackNICID); err != nil {
+		return err
+	}
+	if err := l.attachLocked(restored); err != nil {
+		return err
+	}
+	restored.Restore()
+	l.paused.Store(false)
+	return nil
+}
+
+func (l *PacketLink) stop() {
+	l.mu.Lock()
+	cancel, conn, ep := l.cancel, l.conn, l.ep
+	if conn == nil {
+		conn = l.cfg.Conn
+	}
+	l.cancel, l.conn, l.ep = nil, nil, nil
+	l.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	if conn != nil {
+		_ = conn.Close()
+	}
+	if ep != nil {
+		ep.Close()
+	}
+	l.wg.Wait()
+}
+
+// Close stops the link and closes its connection.
+func (l *PacketLink) Close() error {
+	l.mu.Lock()
+	l.closed = true
+	l.mu.Unlock()
+	l.stop()
+	return nil
+}
