+// initPacketLinkStack builds the guest stack of NetModeLink. A restore attaches
+// eth0 later, to the restored stack, so the connection carries no packet of
+// the throwaway stack.
+func (s *Sandbox) initPacketLinkStack() error {
+	link, err := netbackend.NewPacketLink(netbackend.PacketLinkConfig{
+		Conn:  s.cfg.LinkConn,
+		MTU:   s.cfg.LinkMTU,
+		Stack: s.stackOptions(),
+	})
+	if err != nil {
+		return fmt.Errorf("%w: %w", ErrInvalidConfig, err)
+	}
+	st, err := netbackend.NewLoopbackStack(s.stackOptions())
+	if err != nil {
+		return err
+	}
+	if !s.restoring {
+		if err := link.Attach(st); err != nil {
+			st.Close()
+			return err
+		}
+	}
+	s.netStack = st
+	s.packetLink = link
+	return nil
+}
